// Arduino Nano, PASSIVE buzzer: GND->GND, VCC->5V, I/O->D6
// Ten short public-domain melody excerpts, played sequentially.
// Active buzzers may only beep at a fixed pitch.
#include <Arduino.h>
const byte BUZZER = 6;
struct Note { uint16_t hz; uint16_t ms; };

// 1. Twinkle Twinkle
const Note song1[] = {
  {262,250}, {262,250}, {392,250}, {392,250}, {440,250}, {440,250}, {392,500}, {349,250}, {349,250}, {330,250}, {330,250}, {294,250}, {294,250}, {262,500}
};

// 2. Jingle Bells
const Note song2[] = {
  {330,220}, {330,220}, {330,440}, {330,220}, {330,220}, {330,440}, {330,220}, {392,220}, {262,330}, {294,110}, {330,660}, {349,220}, {349,220}, {349,330}, {349,110}, {349,220}, {330,220}, {330,220}, {330,110}, {330,110}, {330,220}, {294,220}, {294,220}, {330,220}, {294,440}, {392,440}
};

// 3. Ode to Joy
const Note song3[] = {
  {330,220}, {330,220}, {349,220}, {392,220}, {392,220}, {349,220}, {330,220}, {294,220}, {262,220}, {262,220}, {294,220}, {330,220}, {330,330}, {294,110}, {294,440}
};

// 4. Frere Jacques
const Note song4[] = {
  {262,240}, {294,240}, {330,240}, {262,240}, {262,240}, {294,240}, {330,240}, {262,240}, {330,240}, {349,240}, {392,480}, {330,240}, {349,240}, {392,480}
};

// 5. Mary Had a Little Lamb
const Note song5[] = {
  {330,240}, {294,240}, {262,240}, {294,240}, {330,240}, {330,240}, {330,480}, {294,240}, {294,240}, {294,480}, {330,240}, {392,240}, {392,480}
};

// 6. London Bridge
