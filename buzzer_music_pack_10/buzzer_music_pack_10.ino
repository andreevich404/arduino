// 7. Row Row Row Your Boat
const Note song7[] = {
  {262,300}, {262,300}, {262,220}, {294,110}, {330,300}, {330,220}, {294,110}, {330,220}, {349,110}, {392,600}
};

// 8. Old MacDonald
const Note song8[] = {
  {392,240}, {392,240}, {392,240}, {294,240}, {330,240}, {330,240}, {294,480}, {494,240}, {494,240}, {440,240}, {440,240}, {392,480}
