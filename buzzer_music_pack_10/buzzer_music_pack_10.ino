// 9. When the Saints Go Marching In
const Note song9[] = {
  {262,220}, {330,220}, {349,220}, {392,500}, {262,220}, {330,220}, {349,220}, {392,500}, {262,220}, {330,220}, {349,220}, {392,330}, {330,330}, {262,330}, {330,330}, {294,600}
};

// 10. Brahms Lullaby
const Note song10[] = {
  {392,220}, {392,220}, {466,440}, {392,220}, {392,220}, {466,440}, {392,220}, {466,220}, {622,220}, {587,220}, {523,220}, {523,220}, {466,440}
};

template<size_t N> void play(const Note (&notes)[N]) {
  for (size_t i = 0; i < N; ++i) {
    if (notes[i].hz) tone(BUZZER, notes[i].hz, notes[i].ms * 9 / 10);
    else noTone(BUZZER);
    delay(notes[i].ms);
    noTone(BUZZER);
  }
  delay(1200);
}
void setup() { pinMode(BUZZER, OUTPUT); }
void loop() {
  play(song1);
  play(song2);
  play(song3);
  play(song4);
  play(song5);
  play(song6);
  play(song7);
  play(song8);
  play(song9);
  play(song10);
  delay(2500);
}
